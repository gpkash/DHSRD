      property: level
      direction: ASC
    order:
      - file.name
      - card-type
      - recall
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: By type
    groupBy:
      property: card-type
      direction: ASC
    order:
      - file.name
      - domain
      - level
      - recall
    sort:
      - property: domain
        direction: ASC
      - property: level
        direction: ASC
